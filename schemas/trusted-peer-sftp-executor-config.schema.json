{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ellmos-ai/system-gap-master/schemas/trusted-peer-sftp-executor-config.schema.json",
  "title": "Host-local trusted-peer SFTP executor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state_root",
    "receipt_root",
    "credential_roots",
    "ssh_keygen",
    "required_paramiko_version",
    "auth_profiles",
    "signature_verifiers",
    "max_transfer_bytes",
    "max_grant_ttl_seconds",
    "connect_timeout_seconds"
  ],
  "properties": {
    "schema": {"const": "system-gap.trusted-peer-sftp-executor.config.v1"},
    "state_root": {"type": "string", "minLength": 1},
    "receipt_root": {"type": "string", "minLength": 1},
    "credential_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ssh_keygen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "required_paramiko_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "auth_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/authProfile"}
    },
    "signature_verifiers": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/signatureVerifier"}
    },
    "max_transfer_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "max_grant_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "connect_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
  },
  "$defs": {
    "authProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "endpoint_id",
        "username",
        "identity_file",
        "known_hosts_file",
        "remote_account_mode",
        "network_label",
        "remote_host",
        "source_address",
        "allowed_remote_cidrs",
        "allowed_source_cidrs"
      ],
      "properties": {
        "host_id": {"$ref": "trusted-peer-path-registry.schema.json#/$defs/hostId"},
        "endpoint_id": {"$ref": "trusted-peer-path-registry.schema.json#/$defs/id"},
        "username": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "identity_file": {"type": "string", "minLength": 1},
        "known_hosts_file": {"type": "string", "minLength": 1},
        "remote_account_mode": {"const": "read-only"},
        "network_label": {"enum": ["direct", "private-overlay"]},
        "remote_host": {"type": "string", "minLength": 2, "maxLength": 64},
        "source_address": {"type": "string", "minLength": 2, "maxLength": 64},
        "allowed_remote_cidrs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 64}
        },
        "allowed_source_cidrs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 64}
        }
      }
    },
    "signatureVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "algorithm",
        "key_id",
        "reference",
        "signer_identity",
        "namespace",
        "signature_file",
        "allowed_signers_file"
      ],
      "properties": {
        "purpose": {"enum": ["registry", "grant"]},
        "algorithm": {"const": "external-ssh-signature"},
        "key_id": {"$ref": "trusted-peer-path-registry.schema.json#/$defs/id"},
        "reference": {"type": "string", "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9:._/-]{7,255}$"},
        "signer_identity": {"type": "string", "minLength": 1, "maxLength": 128},
        "namespace": {"enum": ["system-gap-registry", "system-gap-transfer-grant"]},
        "signature_file": {"type": "string", "minLength": 1},
        "allowed_signers_file": {"type": "string", "minLength": 1}
      }
    }
  }
}
