{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-bricks/system-gap-master/schemas/trusted-peer-path-entries.schema.json",
  "title": "Host-local trusted peer path publication entries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "paths"
  ],
  "properties": {
    "schema": {
      "const": "system-gap.trusted-peer-paths.entries.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "trusted-peer-path-registry.schema.json#/$defs/path"
      }
    }
  }
}
