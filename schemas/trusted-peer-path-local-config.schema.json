{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ellmos-ai/system-gap-master/schemas/trusted-peer-path-local-config.schema.json",
  "title": "Host-local trusted-peer preparation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "yard_root",
    "local_host_id",
    "local_peer_id",
    "trusted_hosts",
    "pull_destination_roots",
    "max_registry_age_seconds",
    "max_registry_ttl_seconds"
  ],
  "properties": {
    "schema": {
      "const": "system-gap.trusted-peer-paths.local-config.v2"
    },
    "yard_root": {
      "type": "string",
      "minLength": 1
    },
    "local_host_id": {
      "$ref": "trusted-peer-path-registry.schema.json#/$defs/hostId"
    },
    "local_peer_id": {
      "$ref": "trusted-peer-path-registry.schema.json#/$defs/hostId"
    },
    "trusted_hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trustedHost"
      }
    },
    "pull_destination_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_registry_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "max_registry_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    }
  },
  "$defs": {
    "trustedHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "min_revision",
        "signature_algorithm",
        "key_id",
        "signature_reference",
        "allowed_network_labels",
        "allowed_remote_paths",
        "known_host_pins"
      ],
      "properties": {
        "host_id": {
          "$ref": "trusted-peer-path-registry.schema.json#/$defs/hostId"
        },
        "min_revision": {
          "type": "integer",
          "minimum": 1
        },
        "signature_algorithm": {
          "enum": [
            "external-ed25519",
            "external-ssh-signature"
          ]
        },
        "key_id": {
          "$ref": "trusted-peer-path-registry.schema.json#/$defs/id"
        },
        "signature_reference": {
          "type": "string",
          "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9:._/-]{7,255}$"
        },
        "allowed_network_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct",
              "private-overlay"
            ]
          }
        },
        "allowed_remote_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[^\\x00-\\x1f\\x7f\\\\*?\\[\\]{}$`]+$"
          }
        },
        "known_host_pins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endpoint_id",
              "sha256"
            ],
            "properties": {
              "endpoint_id": {
                "$ref": "trusted-peer-path-registry.schema.json#/$defs/id"
              },
              "sha256": {
                "$ref": "trusted-peer-path-registry.schema.json#/$defs/pin"
              }
            }
          }
        }
      }
    }
  }
}
