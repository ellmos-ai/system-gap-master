{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-bricks/system-gap-master/schemas/trusted-peer-path-registry.schema.json",
  "title": "Read-only trusted-peer path metadata registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host_id",
    "revision",
    "published_at",
    "expires_at",
    "endpoints",
    "paths",
    "signature_reference"
  ],
  "properties": {
    "schema": {
      "const": "system-gap.trusted-peer-paths.registry.v2"
    },
    "host_id": {
      "$ref": "#/$defs/hostId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/endpoint"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "signature_reference": {
      "$ref": "#/$defs/signatureReference"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "hostId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "pin": {
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
    },
    "signatureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "ref",
        "payload_sha256"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "external-ed25519",
            "external-ssh-signature"
          ]
        },
        "key_id": {
          "$ref": "#/$defs/id"
        },
        "ref": {
          "type": "string",
          "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9:._/-]{7,255}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "transport",
        "network_label",
        "host",
        "port",
        "username",
        "read_only",
        "known_host_pin"
      ],
      "properties": {
        "endpoint_id": {
          "$ref": "#/$defs/id"
        },
        "transport": {
          "const": "sftp"
        },
        "network_label": {
          "enum": [
            "direct",
            "private-overlay"
          ]
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,252}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "read_only": {
          "const": true
        },
        "known_host_pin": {
          "$ref": "#/$defs/pin"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "kind",
        "metadata_type",
        "content_included",
        "remote_path",
        "endpoint_id",
        "allowed_peer_ids",
        "direct_pull"
      ],
      "properties": {
        "path_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "database/sqlite"
          ]
        },
        "metadata_type": {
          "const": "path-location"
        },
        "content_included": {
          "const": false
        },
        "remote_path": {
          "type": "string",
          "pattern": "^/[^\\x00-\\x1f\\x7f\\\\*?\\[\\]{}$`]+$"
        },
        "endpoint_id": {
          "$ref": "#/$defs/id"
        },
        "allowed_peer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostId"
          }
        },
        "direct_pull": {
          "type": "boolean"
        },
        "adapter": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "database/sqlite"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "adapter"
            ],
            "properties": {
              "direct_pull": {
                "const": false
              },
              "adapter": {
                "const": "sqlite-transit-sync"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "direct_pull": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
