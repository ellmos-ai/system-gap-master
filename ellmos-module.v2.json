{
  "schema": "ellmos.module.v2",
  "id": "system-gap-master",
  "display_name": "system-gap-master",
  "category": "control",
  "kind": "workflow",
  "status": "active",
  "visibility": "public",
  "provides": [
    "sync.files",
    "sync.yard",
    "sync.messages",
    "sync.conflict-copy-reconciliation",
    "sync.trusted-peer-path-registry",
    "sync.trusted-peer-pull-plan"
  ],
  "requires": [],
  "optional": [
    "sync.database"
  ],
  "conflicts": [],
  "surfaces": [
    "cli",
    "api",
    "workflow"
  ],
  "state": {
    "ownership": "external",
    "location": "project"
  },
  "boundaries": {
    "network": "transport-defined",
    "data": "sensitive",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/dev-bricks/system-gap-master"
  },
  "adapters": [
    {
      "id": "sftp",
      "role": "trusted-peer-file-pull",
      "networks": [
        "tailscale",
        "lan"
      ]
    },
    {
      "id": "sqlite-transit-sync",
      "role": "database-snapshot-transit",
      "required_for": [
        "database/sqlite"
      ]
    }
  ]
}
