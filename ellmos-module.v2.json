{
  "schema": "ellmos.module.v2",
  "id": "system-gap-master",
  "display_name": "system-gap-master",
  "category": "control",
  "kind": "workflow",
  "status": "active",
  "visibility": "public",
  "provides": [
    "sync.files",
    "sync.yard",
    "sync.messages",
    "sync.conflict-copy-reconciliation",
    "sync.trusted-peer-path-registry",
    "sync.trusted-peer-pull-preparation",
    "sync.trusted-peer-single-file-pull",
    "sync.ticket-route-intent-adapter"
  ],
  "requires": [],
  "optional": [
    "sync.database"
  ],
  "conflicts": [],
  "surfaces": [
    "cli",
    "api",
    "workflow"
  ],
  "state": {
    "ownership": "external",
    "location": "project"
  },
  "boundaries": {
    "network": "none-by-default; optional signed one-shot sftp",
    "data": "path-metadata by default; one approved regular file through executor",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/ellmos-ai/system-gap-master"
  },
  "adapters": [
    {
      "id": "sftp-preparation",
      "role": "trusted-peer-no-transfer-plan",
      "networks": [
        "direct",
        "private-overlay"
      ]
    },
    {
      "id": "sftp-executor",
      "role": "signed-one-shot-no-overwrite-single-file-pull",
      "networks": [
        "direct",
        "private-overlay"
      ],
      "optional_dependency": "paramiko"
    },
    {
      "id": "ticket-route-intent",
      "role": "validated-ticket-master-intent-to-existing-transport",
      "optional_dependency": "ticket-master>=1.11,<1.12"
    },
    {
      "id": "sqlite-transit-sync",
      "role": "database-snapshot-transit",
      "required_for": [
        "database/sqlite"
      ]
    }
  ]
}
