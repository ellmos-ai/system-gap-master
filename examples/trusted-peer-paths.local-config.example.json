{
  "schema": "system-gap.trusted-peer-paths.local-config.v2",
  "yard_root": "/absolute/path/to/synced/SYNC",
  "local_host_id": "HOST-B",
  "local_peer_id": "PEER-B",
  "trusted_hosts": [
    {
      "host_id": "HOST-A",
      "min_revision": 1,
      "signature_algorithm": "external-ed25519",
      "key_id": "host-a-v1",
      "signature_reference": "urn:replace-with-out-of-band-signature-reference",
      "allowed_network_labels": [
        "direct",
        "private-overlay"
      ],
      "allowed_remote_paths": [
        "/srv/private/example/credentials.json"
      ],
      "known_host_pins": [
        {
          "endpoint_id": "trusted-sftp",
          "sha256": "REPLACE_WITH_VERIFIED_SHA256_HOST_KEY_PIN"
        }
      ]
    }
  ],
  "pull_destination_roots": [
    "/absolute/host-local/imports"
  ],
  "max_registry_age_seconds": 3600,
  "max_registry_ttl_seconds": 7200
}
