{
  "schema": "system-gap.conflict-reconciler.config.v1",
  "actor": "desktop-agent@HOST",
  "mode": "observer",
  "state_dir": "${LOCAL_STATE_DIR}/system-gap-master/conflict-reconciler",
  "receipt_salt": "${LOCAL_RANDOM_RECEIPT_SALT}",
  "lease_seconds": 900,
  "allow_expired_takeover": false,
  "max_files": 10000,
  "max_file_bytes": 10485760,
  "allowed_classes": [
    "exact",
    "append-only-text",
    "three-way-text",
    "json-object"
  ],
  "roots": [
    {
      "id": "shared-yard",
      "path": "${SYNC_ROOT}",
      "archive_dir": "_archive/conflict-copies",
      "cloud_ready": false,
      "known_hosts": [
        "HOST-A",
        "HOST-B"
      ],
      "canonical_mappings": [
        {
          "conflict": "docs/guide (HOST-A conflicted copy).md",
          "canonical": "docs/guide.md",
          "authority": {
            "kind": "manifest",
            "reference": "SYSTEM-MANIFEST:docs/guide.md"
          },
          "adapter": "append-only-text"
        },
        {
          "conflict": "state/settings (conflict).json",
          "canonical": "state/settings.json",
          "authority": {
            "kind": "writer-policy",
            "reference": "state/settings.writer-policy.v1"
          },
          "adapter": "json-object"
        },
        {
          "conflict": "docs/protocol (conflict).md",
          "canonical": "docs/protocol.md",
          "authority": {
            "kind": "pointer",
            "reference": "MANIFEST:protocol"
          },
          "adapter": "three-way-text",
          "base": {
            "path": "_bases/protocol.md",
            "sha256": "REPLACE_WITH_VERIFIED_SHA256"
          }
        }
      ]
    }
  ]
}
