{
  "schema": "system-gap.trusted-peer-paths.entries.v1",
  "revision": 1,
  "paths": [
    {
      "path_id": "service-credential-file",
      "kind": "file",
      "local_path": "/srv/private/example/credentials.json",
      "remote_path": "/srv/private/example/credentials.json",
      "endpoint_id": "tailscale-sftp",
      "allowed_peer_ids": [
        "peer-b"
      ],
      "direct_pull": true,
      "description": "The exact path may be published; the file content never enters the yard."
    },
    {
      "path_id": "application-state",
      "kind": "database/sqlite",
      "local_path": "/var/lib/example/state.sqlite3",
      "remote_path": "/var/lib/example/state.sqlite3",
      "endpoint_id": "tailscale-sftp",
      "allowed_peer_ids": [
        "peer-b"
      ],
      "direct_pull": false,
      "adapter": "sqlite-transit-sync",
      "description": "Discovery only. R9 requires db-transit snapshots."
    }
  ]
}
